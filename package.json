{
  "name": "luma-capture",
  "version": "0.1.4",
  "description": "Luma — local screen recording to crisp GIFs",
  "main": "src/main.cjs",
  "author": "Luma",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac zip",
    "dist:win": "electron-builder --win nsis",
    "test:ui": "electron scripts/ui-smoke.cjs",
    "test:native": "electron scripts/native-window-smoke.cjs",
    "test:region": "electron scripts/region-selection-smoke.cjs",
    "test:lifecycle": "node scripts/lifecycle-smoke.cjs"
  },
  "build": {
    "appId": "app.luma.capture",
    "productName": "Luma",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Luma 需要录制您选择的屏幕或窗口，以生成 GIF 动图。"
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
